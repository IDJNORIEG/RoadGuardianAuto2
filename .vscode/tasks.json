{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🎮 Emulador: Crear AVD",
            "type": "shell",
            "command": "${env:ANDROID_HOME}\\cmdline-tools\\latest\\bin\\avdmanager.bat",
            "args": [
                "create", "avd",
                "-n", "RoadGuardian_Emulator",
                "-k", "system-images;android-34;google_apis_playstore;x86_64",
                "-d", "pixel_6_pro"
            ],
            "problemMatcher": []
        },
        {
            "label": "🎮 Emulador: Iniciar",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File", "${workspaceFolder}\\launch-emulator.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "🖥️ Scrcpy: Conectar Dispositivo",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File", "${workspaceFolder}\\run-with-scrcpy.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "🏗️ Build Debug",
            "type": "shell",
            "command": "${workspaceFolder}\\gradlew.bat",
            "args": ["assembleDebug"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "📱 Instalar y Ejecutar",
            "type": "shell",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Debug"
            ],
            "command": "powershell",
            "args": [
                "-Command",
                "adb install -r ${workspaceFolder}\\app\\build\\outputs\\apk\\debug\\app-debug.apk; adb shell am start -n com.roadguardian.auto/.MainActivity"
            ],
            "problemMatcher": []
        },
        {
            "label": "📊 Ver Logs",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "adb logcat -c; adb logcat | Select-String 'RoadGuardian|AndroidRuntime'"
            ],
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "🔄 Hot Reload",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "adb shell am force-stop com.roadguardian.auto; ${workspaceFolder}\\gradlew.bat assembleDebug; adb install -r ${workspaceFolder}\\app\\build\\outputs\\apk\\debug\\app-debug.apk; adb shell am start -n com.roadguardian.auto/.MainActivity"
            ],
            "problemMatcher": []
        },
        {
            "label": "🎬 Workflow Completo: Emulador",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Emulador: Iniciar",
                "Build Debug",
                "Instalar y Ejecutar",
                "Ver Logs"
            ],
            "problemMatcher": []
        },
        {
            "label": "🎬 Workflow Completo: Scrcpy",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-File", "${workspaceFolder}\\run-with-scrcpy.ps1"
            ],
            "problemMatcher": []
        }
    ]
}